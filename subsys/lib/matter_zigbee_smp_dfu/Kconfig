menuconfig MATTER_ZIGBEE_SMP_DFU
	bool "SMP DFU button handler for combined Matter + Zigbee samples"
	depends on MATTER_ZIGBEE_ADD_ON && CHIP_DFU_OVER_BT_SMP
	depends on NCS_SAMPLE_MATTER_CUSTOM_BLUETOOTH_ADVERTISING
	default n
	help
	  Deprecated: SMP DFU is handled by the common UI module when
	  CONFIG_MATTER_ZIGBEE_UI_SMP_DFU is enabled. This standalone option
	  registers a separate chained button handler and should not be used
	  together with matter_zigbee_ui.

if MATTER_ZIGBEE_SMP_DFU

module = MATTER_ZIGBEE_SMP_DFU
module-str = Matter/Zigbee SMP DFU
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif # MATTER_ZIGBEE_SMP_DFU
