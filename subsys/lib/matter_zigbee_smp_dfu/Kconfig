menuconfig MATTER_ZIGBEE_SMP_DFU
	bool "SMP DFU button handler for combined Matter + Zigbee samples"
	depends on MATTER_ZIGBEE_ADD_ON && CHIP_DFU_OVER_BT_SMP
	depends on NCS_SAMPLE_MATTER_CUSTOM_BLUETOOTH_ADVERTISING
	default y
	help
	  Register a Button 0 handler (DK Button 1) that starts SMP BLE
	  advertising when the device is already commissioned to a Matter
	  fabric, even if Thread is disabled and the active protocol is Zigbee.

	  This replaces the default handler in the Nordic Matter board module,
	  which only starts SMP when the device state is DeviceProvisioned
	  (Thread up). Enable
	  CONFIG_NCS_SAMPLE_MATTER_CUSTOM_BLUETOOTH_ADVERTISING in the
	  application to disable that default path.

if MATTER_ZIGBEE_SMP_DFU

module = MATTER_ZIGBEE_SMP_DFU
module-str = Matter/Zigbee SMP DFU
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif # MATTER_ZIGBEE_SMP_DFU
